#!/bin/bash
# Pre-commit hook for unblock project
# Install: composer run hook:install
# Checks: lock file sync, syntax, lint, PHPStan, tests

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() {
    echo -e "${RED}✗ $1${NC}"
    exit 1
}

pass() {
    echo -e "${GREEN}✓ $1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

echo ""
echo "━━━ Pre-commit checks ━━━"
echo ""

# ── 1. Lock file integrity ──────────────────────────────────────────

echo "Checking lock file integrity..."

# Check if composer.json is staged
COMPOSER_JSON_STAGED=$(git diff --cached --name-only | grep -c '^composer\.json$' || true)
COMPOSER_LOCK_STAGED=$(git diff --cached --name-only | grep -c '^composer\.lock$' || true)

if [ "$COMPOSER_JSON_STAGED" -gt 0 ] && [ "$COMPOSER_LOCK_STAGED" -eq 0 ]; then
    fail "composer.json is staged but composer.lock is NOT staged.
   Run 'composer update' and stage composer.lock before committing.
   This prevents broken deployments where lock file doesn't match requirements."
fi

# Validate lock is in sync (even if neither is staged, catch drift)
composer validate --check-lock --no-interaction --quiet 2>/dev/null || {
    fail "composer.lock is out of sync with composer.json.
   Run 'composer update' and stage both files."
}

pass "Lock files in sync"

# Check pnpm lock file too
PACKAGE_JSON_STAGED=$(git diff --cached --name-only | grep -c '^package\.json$' || true)
PNPM_LOCK_STAGED=$(git diff --cached --name-only | grep -c '^pnpm-lock\.yaml$' || true)

if [ "$PACKAGE_JSON_STAGED" -gt 0 ] && [ "$PNPM_LOCK_STAGED" -eq 0 ]; then
    warn "package.json is staged but pnpm-lock.yaml is NOT staged.
   Consider running 'pnpm install' and staging the lock file."
fi

# ── 2. PHP syntax check ─────────────────────────────────────────────

echo "Checking PHP syntax..."

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -n "$STAGED_PHP_FILES" ]; then
    for file in $STAGED_PHP_FILES; do
        if [ -f "$file" ]; then
            php -l "$file" > /dev/null 2>&1 || fail "Syntax error in $file"
        fi
    done
    pass "PHP syntax OK ($(echo "$STAGED_PHP_FILES" | wc -l | tr -d ' ') files)"
else
    pass "No PHP files staged"
fi

# ── 3. Code style (Pint) ────────────────────────────────────────────

echo "Checking code style..."

if [ -n "$STAGED_PHP_FILES" ]; then
    vendor/bin/pint --test --quiet 2>/dev/null || {
        warn "Code style issues found. Running pint to fix..."
        vendor/bin/pint --quiet
        echo -e "${YELLOW}   Files were auto-fixed. Review and re-stage them.${NC}"
        exit 1
    }
    pass "Code style OK"
else
    pass "No PHP files to lint"
fi

# ── 4. PHPStan static analysis ──────────────────────────────────────

echo "Running static analysis..."

vendor/bin/phpstan analyse --memory-limit=1G --no-progress --quiet 2>/dev/null || {
    fail "PHPStan found errors. Run 'vendor/bin/phpstan analyse' for details."
}

pass "PHPStan OK"

# ── 5. Tests ─────────────────────────────────────────────────────────

echo "Running tests..."

php artisan config:clear --ansi --quiet 2>/dev/null
php artisan test --compact --stop-on-failure 2>/dev/null || {
    fail "Tests failed. Run 'php artisan test' for details."
}

pass "Tests passed"

echo ""
echo -e "${GREEN}━━━ All pre-commit checks passed ━━━${NC}"
echo ""
