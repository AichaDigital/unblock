includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app

    # Exclude directories that are not business logic or have framework-generated code
    excludePaths:
        - bootstrap/cache
        - storage/*
        - node_modules/*
        - app/Console/Commands/Develop
        - app/Console/Commands/UserAuthorizeCommand.php
        - app/Console/Commands/UserCreateCommand.php
        - app/Console/Commands/AddHostKeyCommand.php
        - app/Filament
        - app/Livewire
        - app/Notifications

    # Basic strict rules that are supported
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # Laravel specific
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []

    # Type coverage
    typeAliases:
        UserId: 'string'
        SiteId: 'string'
        NodeId: 'string'
        QueueName: 'string'
        RegionCode: 'string'

    # Ignore patterns (minimize these over time)
    ignoreErrors:
        # Ray debug calls (development only)
        - '#Call to function ray\(\) on a separate line has no effect\.#'

        # Temporary ignores for migration period
        - '#Access to an undefined property App\\Models\\[^:]+::\$[^.]+\.#'
        - '#Strict comparison using === between true and true will always evaluate to true\.#'

    # Cache for faster analysis
    tmpDir: storage/phpstan%
